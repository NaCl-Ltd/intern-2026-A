<li id="micropost-<%= micropost.id %>">
  <%= link_to gravatar_for(micropost.user, size: 50), micropost.user %>
  <span class="user"><%= link_to micropost.user.name, micropost.user %></span>
  <span class="micropost"><%= micropost.pinned? ? "†Pinned" : "" %></span>
  <span class="content">
    <%= micropost.content %>
    <% if micropost.image.attached? %>
      <%= image_tag micropost.image.variant(:display) %>
    <% end %>
  </span>
  <span class="timestamp">
    Posted <%= time_ago_in_words(micropost.created_at) %> ago.
    <% if current_user?(micropost.user) %>
      <%= link_to "pin", pin_micropost_path(micropost), data: { "turbo-method": :patch, turbo_confirm: "Sure?" } %>
      <%= link_to "delete", micropost, data: { "turbo-method": :delete, turbo_confirm: "Sure?" } %>
    <% end %>
  </span>
</li>
