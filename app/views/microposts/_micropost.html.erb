<li id="micropost-<%= micropost.id %>">
  <%= link_to gravatar_for(micropost.user, size: 50), micropost.user %>
  <span class="user"><%= link_to micropost.user.name, micropost.user %></span>
  <span class="micropost"><i><font color="#707070"><%= micropost.pinned? ? "†Pinned†" : "" %></font></i></span>
  <span class="content">
    <%= html_with_link_to_hashtag(micropost.content) %> <!-- ハッシュタグがリンク化されたポストの内容を表示 -->
    <% if micropost.image.attached? %>
      <%= image_tag micropost.image.variant(:display) %>
    <% end %>
    <% if micropost.audio.attached? %>
      <%= audio_tag url_for(micropost.audio), controls: true %>
    <% end %>
  </span>
  <span class="timestamp">
    Composed <%= time_ago_in_words(micropost.created_at) %> ago.
    <% if current_user?(micropost.user) %>
      <% if micropost.pinned? %>
        <%= link_to "unpin", unpin_micropost_path(micropost), data: { "turbo-method": :patch, turbo_confirm: "You are unpinning this micropost. Sure?" } %>
      <% else %>
        <%= link_to "pin", pin_micropost_path(micropost), data: { "turbo-method": :patch, turbo_confirm: "You are pinning this micropost. If there is already a pinned micropost, it will be unpinned. Sure?" } %>
      <% end %>
      <%= link_to "delete", micropost, data: { "turbo-method": :delete, turbo_confirm: "You are DELETING this micropost. This action can NOT be undone. Continue?" } %>
    <% end %>
  </span>
</li>
