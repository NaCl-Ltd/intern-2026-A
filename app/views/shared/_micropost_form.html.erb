<%= form_with(model: @micropost) do |f| %>
  <%= render 'shared/error_messages', object: f.object %>
  <div class="field">
    <%= f.text_area :content, placeholder: "Compose new micropost..." %>
  </div>
  <span class="image">
    <label>画像ファイルを選択:</label>
    <%= f.file_field :image, accept: "image/jpeg,image/gif,image/png" %>
  </span>
  <span class="image">
    <label>音声ファイルを選択:</label>
  <%= f.file_field :audio, accept: "audio/mpeg,audio/aac,audio/mp4,audio/ogg" %>
  </span>
  <%= f.submit "Post", class: "btn btn-primary" %> <!--送信-->
<% end %>
